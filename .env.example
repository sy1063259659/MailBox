# MailBox currently keeps GPTBOX_* runtime environment variables for deployment compatibility. Legacy MAILBOX_* names are still accepted by the server.
GPTBOX_SERVER_ADDR=0.0.0.0:8787
GPTBOX_STATIC_DIR=/app/dist
GPTBOX_SQLITE_PATH=/app/data/mailbox.db
GPTBOX_ADMIN_USERNAME=admin
GPTBOX_ADMIN_PASSWORD=change-me-to-a-strong-password
GPTBOX_SESSION_SECRET=change-me-to-a-long-random-string
GPTBOX_TOKEN_KEY=change-me-to-another-long-random-string
GPTBOX_COOKIE_SECURE=false

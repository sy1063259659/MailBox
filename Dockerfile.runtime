FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home --home-dir /app mailbox

WORKDIR /app
COPY build/gptbox-server-linux-amd64 /app/gptbox-server
COPY dist /app/dist

RUN chmod +x /app/gptbox-server

ENV GPTBOX_SERVER_ADDR=0.0.0.0:8787
ENV GPTBOX_STATIC_DIR=/app/dist
EXPOSE 8787
USER mailbox
ENTRYPOINT ["/app/gptbox-server"]
